# Copier ce fichier en .env et remplir. Ne jamais committer .env.

# Acces Xtream Codes (URL du serveur avec le port, sans slash final)
XTREAM_URL=http://exemple.serveur.tv:8080
XTREAM_USER=
XTREAM_PASSWORD=
# Certains serveurs refusent les clients inconnus : user-agent type lecteur Android
XTREAM_USER_AGENT=okhttp/4.12.0

# Cle API https://www.football-data.org (offre gratuite : PL, FL1, CL)
FOOTBALL_DATA_TOKEN=
